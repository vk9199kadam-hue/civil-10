# =============================================
# FIREBASE — Firestore (text/data storage)
# =============================================
VITE_FIREBASE_API_KEY=your_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id
VITE_FIREBASE_MEASUREMENT_ID=your_measurement_id

# =============================================
# IMAGEKIT — Image storage
# =============================================
# Sign up at https://imagekit.io
# URL Endpoint: e.g. https://ik.imagekit.io/your_id/
# Public Key: Developer Options → API Keys
# Private Key: Developer Options → API Keys
VITE_IMAGEKIT_URL_ENDPOINT=your_url_endpoint
VITE_IMAGEKIT_PUBLIC_KEY=your_public_key
VITE_IMAGEKIT_PRIVATE_KEY=your_private_key

